# Copie as variáveis abaixo para o painel do servidor (Render, Railway...).
# Localmente nada disso é obrigatório: sem DATABASE_URL o backend usa SQLite.

# Endereço do PostgreSQL (o Render/Railway fornece pronto).
DATABASE_URL=postgresql://usuario:senha@host:5432/atala

# OBRIGATÓRIA em produção. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ATALA_JWT_SECRET=

# Quantos dias o login dura antes de pedir a senha de novo.
ATALA_JWT_VALIDADE_DIAS=30

# Gera 30 dias de histórico SINTÉTICO para produtos vistos pela primeira vez
# (para a apresentação). 1 = ligado (padrão), 0 = desligado.
ATALA_HISTORICO_SIMULADO=1

# Domínios web extras que podem chamar a API (separados por vírgula). Extensão e apps
# mobile nativos não precisam estar aqui.
ATALA_CORS_ORIGENS=
